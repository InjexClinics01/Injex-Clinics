# -----------------------------------------------------------------------------
# Injex Clinics — frontend environment
# Copy to .env.local and fill in. Never commit .env / .env.local.
# Supabase Dashboard → Project Settings → API Keys
# (Supabase replaced anon/service_role with publishable/secret keys:
#  https://github.com/orgs/supabase/discussions/29260)
# -----------------------------------------------------------------------------

# Public (exposed to the browser — safe: data is protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key: starts with sb_publishable_   (replaces the legacy "anon" key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Absolute URL of this app, used in password-reset / invitation email links.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IANA time zone used to display dates (and, from Phase 2, to define "today").
NEXT_PUBLIC_APP_TIME_ZONE=Europe/London

# -----------------------------------------------------------------------------
# SERVER-ONLY SECRET — never prefix with NEXT_PUBLIC_, never commit.
# Secret key: starts with sb_secret_   (replaces the legacy "service_role" key)
# Required for admins to create / invite / deactivate employee accounts.
# On Vercel add it as an environment variable (it is never sent to browsers).
# -----------------------------------------------------------------------------
SUPABASE_SECRET_KEY=

# Legacy names are still read as a fallback if you have an older project:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  → use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   SUPABASE_SERVICE_ROLE_KEY      → use SUPABASE_SECRET_KEY

SUPABASE_URL=https://your-project-ref.supabase.co

# SECRET key: starts with sb_secret_ (replaces the legacy service_role key).
# Bypasses Row Level Security — keep it private.
SUPABASE_SECRET_KEY=

# Optional: Postgres connection string for running migrations/tests with psql
# Supabase Dashboard → Connect → Session pooler (port 5432)
SUPABASE_DB_URL=
